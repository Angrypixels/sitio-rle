---
import Base from '../layouts/Base.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { cargar } from '../lib/datos.js';
import { textos, fecha, ruta, recurso } from '../lib/i18n.js';
const { lang = 'es' } = Astro.props;
const t = textos[lang];
const d = cargar();
// Aparece cuando exista public/img/ilustracion-novedades.webp (WebP con transparencia)
const hayIlustracion = existsSync(join(process.cwd(), 'public', 'img', 'ilustracion-novedades.webp'));
---
<Base lang={lang} seccion="novedades" pagina="novedades" titulo={t.nav.novedades} esEjemplo={d.esEjemplo}>
  <section class="cabeza grano">
    <div class="cont">
      <h1>{t.nav.novedades}</h1>
      <p>{t.novIntro}</p>
    </div>
  </section>
  <section class="seccion">
    <div class="cont dos">
      <ul class="tiempo">
        {d.hitos.map((h) => (
          <li>
            <time datetime={h.fecha}>{fecha(h.fecha, lang)}</time>
            <div>
              {h[`texto_${lang}`] || t.cumplio(h.aliado, d.config.roles.find((r) => r.id === h.rol)[`largo_${lang}`])}
              <small><a href={ruta(lang, `indicadores/${h.indicador.slug}`)}>{h.indicador[lang]}</a></small>
            </div>
          </li>
        ))}
        {!d.hitos.length && <li class="previsto"><div>{t.sinNovedades}</div></li>}
      </ul>
      <div class="lado">
      <aside class="suscribir">
        <h2>{t.susTit}</h2>
        <p>{t.susTxt}</p>
        <form onsubmit="this.nextElementSibling.classList.add('activa'); return false">
          <label class="oculto" for="correo">{t.correo}</label>
          <input id="correo" type="email" placeholder={t.correo} />
          <button class="boton">{t.suscribir}</button>
        </form>
        <p class="nota">{t.susNota}</p>
      </aside>
      {hayIlustracion
        ? <img class="ilustracion alta" src={recurso('img/ilustracion-novedades.webp')} alt="" />
        : <div class="ilustracion alta hueco">{t.ilustracion}</div>}
      </div>
    </div>
  </section>
</Base>
