---
import Base from '../layouts/Base.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { cargar } from '../lib/datos.js';
import { textos, fecha, ruta, recurso } from '../lib/i18n.js';
import sitio from '../../datos/sitio.json';
const { lang = 'es' } = Astro.props;
const t = textos[lang];
const d = cargar();
// Suscripción: se activa al poner en datos/sitio.json la dirección del formulario del servicio de correo.
const { formulario, politica, contacto } = sitio.suscripcion;
// Aparece cuando exista public/img/ilustracion-novedades.webp (WebP con transparencia)
const hayIlustracion = existsSync(join(process.cwd(), 'public', 'img', 'ilustracion-novedades.webp'));
---
<Base lang={lang} seccion="novedades" pagina="novedades" titulo={t.nav.novedades} esEjemplo={d.esEjemplo}>
  <section class="cabeza grano">
    <div class="cont">
      <h1>{t.nav.novedades}</h1>
      <p>{t.novIntro}</p>
    </div>
  </section>
  <section class="seccion">
    <div class="cont dos">
      <ul class="tiempo">
        {d.hitos.map((h) => (
          <li>
            <time datetime={h.fecha}>{fecha(h.fecha, lang)}</time>
            <div>
              {h[`texto_${lang}`] || t.cumplio(h.aliado, d.config.roles.find((r) => r.id === h.rol)[`largo_${lang}`])}
              <small><a href={ruta(lang, `indicadores/${h.indicador.slug}`)}>{h.indicador[lang]}</a></small>
            </div>
          </li>
        ))}
        {!d.hitos.length && <li class="previsto"><div>{t.sinNovedades}</div></li>}
      </ul>
      <div class="lado">
      <aside class="suscribir">
        <h2>{t.susTit}</h2>
        <p>{t.susTxt}</p>
        {formulario ? (
          <form class="alta-correo" method="post" action={formulario} data-listo={t.susListo} data-error={t.susError}>
            <div class="campo">
              <label class="oculto" for="correo">{t.correo}</label>
              <input id="correo" name="EMAIL" type="email" autocomplete="email" placeholder={t.correo} required />
              <button class="boton">{t.suscribir}</button>
            </div>
            <label class="autoriza"><input type="checkbox" required /> <span>{t.susAutoriza}</span></label>
            <input class="oculto" type="text" name="email_address_check" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="locale" value={lang} />
            <p class="nota estado" role="status"></p>
          </form>
        ) : (
          <form>
            <div class="campo">
              <label class="oculto" for="correo">{t.correo}</label>
              <input id="correo" type="email" placeholder={t.correo} disabled />
              <button class="boton" disabled>{t.suscribir}</button>
            </div>
            <p class="nota activa">{t.susNota}</p>
          </form>
        )}
        {formulario && (
          <p class="nota">
            {t.susAviso} {contacto && <>{t.susContacto} <a href={`mailto:${contacto}`}>{contacto}</a>.</>} {politica && <a href={politica}>{t.susPolitica}</a>}
          </p>
        )}
      </aside>
      {hayIlustracion
        ? <img class="ilustracion alta" src={recurso('img/ilustracion-novedades.webp')} alt="" />
        : <div class="ilustracion alta hueco">{t.ilustracion}</div>}
      </div>
    </div>
  </section>
</Base>

<script>
  // Envía la suscripción sin salir de la página. Sin JavaScript, el formulario se envía de la forma normal.
  document.querySelectorAll('.alta-correo').forEach((f) => {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const estado = f.querySelector('.estado');
      const boton = f.querySelector('button');
      boton.disabled = true;
      let bien = false;
      try {
        const r = await fetch(`${f.action}${f.action.includes('?') ? '&' : '?'}isAjax=1`, { method: 'POST', body: new FormData(f) });
        bien = r.ok && (await r.json()).success !== false;
      } catch { bien = false; }
      estado.textContent = bien ? f.dataset.listo : f.dataset.error;
      estado.classList.add('activa');
      if (bien) f.reset();
      boton.disabled = false;
    });
  });
</script>
