---
// Tipografías alojadas en el propio sitio (sin llamadas a Google Fonts).
import '@fontsource-variable/geologica/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import { textos, ruta, recurso } from '../lib/i18n.js';
const { lang = 'es', seccion = 'indice', pagina = '', titulo, descripcion, esEjemplo = false } = Astro.props;
const t = textos[lang];
const otro = lang === 'es' ? 'en' : 'es';
// Logos del pie: [archivo, texto alternativo, ancho, alto del SVG, sitio oficial]. Todos se escalan con el mismo factor,
// así conservan entre sí las proporciones con que se exportaron.
const logos = [
  ['bmukn', 'Ministerio Federal de Medio Ambiente de Alemania (BMUKN)', 375.46, 156.6, 'https://www.bundesumweltministerium.de/'],
  ['iki', 'Iniciativa Internacional del Clima (IKI)', 312.49, 71.51, 'https://www.international-climate-initiative.com/'],
  ['unep-wcmc', 'UNEP-WCMC', 210.99, 61.78, 'https://www.unep-wcmc.org/'],
  ['nmsi', 'Iniciativa de Apoyo al Monitoreo Nacional', 205.76, 81.85, 'https://www.monitoring-support.org/'],
  ['humboldt', 'Instituto Humboldt', 74.93, 81.37, 'https://www.humboldt.org.co/'],
  ['centro-subregional', 'Centro Subregional para la cooperación en Biodiversidad', 229.17, 69.13, 'https://proyectos.humboldt.org.co/enqueandaelhumboldt/2025/centro.html'],
];
// Datos para buscadores y para la vista previa al compartir el enlace.
const tituloPagina = titulo ? `${titulo} · ${t.sitio}` : `${t.sitio} · ${t.sub}`;
const resumen = descripcion || t.heroMide;
const absoluta = (p) => new URL(p, Astro.site).href;
const nav = [['indice', ruta(lang)], ['indicadores', ruta(lang, 'indicadores')], ['aliados', ruta(lang, 'aliados')], ['novedades', ruta(lang, 'novedades')]];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={resumen} />
    <link rel="canonical" href={absoluta(ruta(lang, pagina))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.sitio} />
    <meta property="og:title" content={titulo || t.heroTitulo} />
    <meta property="og:description" content={resumen} />
    <meta property="og:url" content={absoluta(ruta(lang, pagina))} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_GB'} />
    <meta property="og:image" content={absoluta(recurso('img/compartir.png'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Mientras el sitio muestre el aviso de prototipo, se pide a los buscadores que no lo guarden. */}
    {esEjemplo && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={recurso('favicon.svg')} />
    <link rel="alternate" hreflang={lang} href={absoluta(ruta(lang, pagina))} />
    <link rel="alternate" hreflang={otro} href={absoluta(ruta(otro, pagina))} />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.saltar}</a>
    {esEjemplo && <div class="aviso">{t.ejemplo}</div>}
    <header class="barra">
      <div class="cont">
        <a class="marca" href={ruta(lang)}>
          <b>{t.sitio}</b><span>{t.sub}</span>
        </a>
        <nav aria-label={t.navPrincipal}>{nav.map(([k, href]) => <a href={href} aria-current={k === seccion ? 'page' : undefined}>{t.nav[k]}</a>)}</nav>
        <a class="lang" href={ruta(otro, pagina)} lang={otro}>{t.idioma}</a>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer>
      <div class="cont">
        <div class="logos">
          {logos.map(([f, alt, w, h, url]) => {
            const img = <img src={recurso(`img/logos/${f}.svg`)} alt={alt} width={w} height={h} />;
            return url
              ? <a href={url} target="_blank" rel="noopener" style={`--w:${w};--h:${h}`}>{img}</a>
              : <span style={`--w:${w};--h:${h}`}>{img}</span>;
          })}
        </div>
        <p>{t.pie}</p>
      </div>
    </footer>
  </body>
</html>
